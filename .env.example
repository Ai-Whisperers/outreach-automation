# Environment Configuration
ENVIRONMENT=development
DEBUG=true

# API Security
API_KEY=your-secure-api-key-here

# SendGrid
SENDGRID_API_KEY=your-sendgrid-api-key

# Email Configuration
EMAIL_FROM_ADDRESS=your-email@example.com
EMAIL_FROM_NAME=Your Name

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./campaign_generator.db

# CORS (localhost for development)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# Logging
LOG_LEVEL=DEBUG

# Cache
CACHE_ENABLED=true
CACHE_TTL_MEMORY=3600
CACHE_TTL_FILE=86400

# Rate Limiting
RATE_LIMIT_ENABLED=true

# =============================================================================
# Database Configuration (PostgreSQL) - for production
# =============================================================================
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/database_name

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_TTL=3600

# =============================================================================
# Celery Configuration
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# AI Providers (ADD YOUR KEYS HERE)
# =============================================================================
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
